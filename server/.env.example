# Server env sample - copy to server/.env

# Core
PORT=5000
# Mongo connection string, e.g. mongodb://localhost:27017/expense_tracker or Atlas URI
CONNECTION_URL=
# Strong random secret for JWT signing
JWT_SECRET=

# CORS / URLs
# URL where the client runs locally or in production
CLIENT_URL=http://localhost:3000
# Public base URL of the API (used to build absolute file URLs for receipts)
PUBLIC_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Email (for reset password, notifications)
EMAIL_USERNAME=
EMAIL_PASSWORD=
FROM_NAME=ExpenseTracker
FROM_EMAIL=no-reply@example.com

# Google OAuth
GOOGLE_CLIENT_ID=

# Salt Edge (bank integration)
SALT_EDGE_APP_ID=
SALT_EDGE_SECRET=
