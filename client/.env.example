REACT_APP_API_URL=
REACT_APP_GOOGLE_CLIENT_ID=

# Notes:
# - If REACT_APP_API_URL is empty, the CRA proxy in client/package.json (http://localhost:5000)
#   will be used for relative /api requests during development.
# - For production on Vercel/Netlify, set REACT_APP_API_URL to your deployed API base URL.
# - Create .env.local for local, uncommitted overrides.
