# Server Environment Variables
PORT=5000
CLIENT_URL=http://localhost:3000
CONNECTION_URL=mongodb://localhost:27017/expense-tracker
JWT_SECRET=your_jwt_secret_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Email (Gmail SMTP)
EMAIL_USERNAME=your_gmail_username@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
FROM_EMAIL=your_gmail_username@gmail.com
FROM_NAME=Expense Tracker

# Frontend URL for links in emails
FRONTEND_URL=http://localhost:3000

# Salt Edge (Bank integration)
SALT_EDGE_APP_ID=your_salt_edge_app_id
SALT_EDGE_SECRET=your_salt_edge_secret