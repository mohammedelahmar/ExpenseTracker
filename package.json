{
  "name": "expense-tracker-monorepo",
  "private": true,
  "dependencies": {
    "react-webcam": "^7.2.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "bestzip": "^2.2.1",
    "postcss": "^8.5.6",
    "rimraf": "^6.0.1",
    "shx": "^0.3.4",
    "tailwindcss": "^4.1.11"
  },
  "scripts": {
  "package:prep": "rimraf dist && shx mkdir -p dist",
  "package:source": "node scripts/package-source.js",
  "package:client": "node scripts/zip-client-build.js",
  "package:all": "npm run -s package:prep && npm run -s package:source && npm run -s package:client"
  }
}
